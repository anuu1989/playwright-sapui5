{
  "name": "svm-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Black Duck -> SVM end-to-end sync test: scan-driven add/remove with a state-machine orchestrator and Playwright SVM checks.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start-run": "tsx src/cli.ts start",
    "tick": "tsx src/cli.ts tick",
    "notify": "tsx src/cli.ts notify",
    "cleanup": "tsx src/cli.ts cleanup",
    "status": "tsx src/cli.ts status",
    "verify": "playwright test --pass-with-no-tests",
    "tick:all": "npm run tick && (npx playwright test --pass-with-no-tests; rc=$?; npm run notify; exit $rc)",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
